# ── Docker Hub ────────────────────────────────────────────────────────────────
# Usuario donde están publicadas las imágenes (no cambiar)
DOCKER_HUB_USER=crodrigr
IMAGE_TAG=latest

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_NAME=postgres
DB_USER=admin
DB_PASSWORD=changeme

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=changeme-replace-with-openssl-rand-hex-32

# ── URLs — reemplaza <IP> con la IP pública del servidor o el dominio ─────────
CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_FRONTEND_URL=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# ── OTP (autenticación de dos pasos) ─────────────────────────────────────────
# En producción cambiar OTP_FIXED_ENABLED a false
OTP_FIXED_ENABLED=true
OTP_FIXED_CODE=111111

# ── Correo (Gmail) ────────────────────────────────────────────────────────────
# Usar una contraseña de aplicación de Google (no la contraseña de la cuenta)
# https://myaccount.google.com/apppasswords
GMAIL_USER=tu-correo@gmail.com
GMAIL_PASS=xxxx xxxx xxxx xxxx
