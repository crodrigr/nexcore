{
  "info": {
    "name": "Nexcore - Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de endpoints NexCore: módulo tenant (Tenants, Usuarios, Roles) y módulo menu (Perfil de UI)."
  },
  "variable": [
    { "key": "base_url",          "value": "http://localhost:8080" },
    { "key": "auth_base_url",     "value": "http://localhost:8081", "description": "Base URL for Auth Service" },
    { "key": "tenant_system_id",  "value": "00000000-0000-0000-0000-000000000001", "description": "Tenant system" },
    { "key": "tenant_demo_id",    "value": "00000000-0000-0000-0000-000000000002", "description": "Tenant demo" },
    { "key": "tenant_id",         "value": "00000000-0000-0000-0000-000000000001", "description": "Tenant activo usado en los headers (cambiar según contexto)" },
    { "key": "actor_id",          "value": "00000000-0000-0000-0001-000000000001", "description": "super.admin (sistema)" },
    { "key": "actor_demo_id",     "value": "00000000-0000-0000-0001-000000000002", "description": "admin.demo (tenant demo)" },
    { "key": "tenant_slug",       "value": "demo" },
    { "key": "test_username",     "value": "super.admin" },
    { "key": "test_password",     "value": "NexCore@2026!" },
    { "key": "challenge_token",   "value": "", "description": "Token from login (step 1)" },
    { "key": "access_token",      "value": "", "description": "JWT access token" },
    { "key": "refresh_token",     "value": "", "description": "Refresh token" },
    { "key": "session_id",        "value": "", "description": "Current session ID" },
    { "key": "user_id",           "value": "", "description": "Current user ID" },
    { "key": "component_id",      "value": "", "description": "UUID del componente (completar con UUID real de la BD)" },
    { "key": "role_id",           "value": "00000000-0000-0000-0000-000000000010", "description": "UUID del rol (TENANT_ADMIN del tenant demo)" },
    { "key": "element_id",        "value": "", "description": "UUID del elemento de componente (completar con UUID real de la BD)" }
  ],
  "item": [
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Listar tenants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "SUPER_ADMIN — Lista todos los tenants paginados."
          }
        },
        {
          "name": "Crear tenant",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"mi-empresa\",\n  \"name\": \"Mi Empresa SAS\",\n  \"legalName\": \"Mi Empresa S.A.S.\",\n  \"taxId\": \"900123456-1\",\n  \"plan\": \"STARTER\",\n  \"mode\": \"SAAS_SHARED\",\n  \"timezone\": \"America/Bogota\",\n  \"locale\": \"es-CO\",\n  \"dateFormat\": \"DD/MM/YYYY\",\n  \"currency\": \"COP\"\n}"
            },
            "description": "SUPER_ADMIN — Crea un nuevo tenant. El trigger de BD crea automáticamente los roles TENANT_ADMIN, EDITOR y VIEWER."
          }
        },
        {
          "name": "Obtener tenant por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}"]
            },
            "description": "Obtiene el detalle de un tenant por su UUID."
          }
        },
        {
          "name": "Actualizar tenant",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Actor-Super-Admin", "value": "false" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mi Empresa Actualizada SAS\",\n  \"legalName\": \"Mi Empresa Actualizada S.A.S.\",\n  \"timezone\": \"America/Bogota\",\n  \"locale\": \"es-CO\",\n  \"mfaRequired\": false,\n  \"sessionTimeoutMinutes\": 480,\n  \"maxLoginAttempts\": 5,\n  \"passwordMinLength\": 8,\n  \"passwordRequiresUpper\": true,\n  \"passwordRequiresSpecial\": false\n}"
            },
            "description": "Actualiza datos del tenant. X-Actor-Super-Admin=true permite cambiar plan/modo."
          }
        },
        {
          "name": "Suspender tenant",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/suspend",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "suspend"]
            },
            "description": "SUPER_ADMIN — Suspende el tenant. Retorna 204 No Content."
          }
        },
        {
          "name": "Activar tenant",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/activate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "activate"]
            },
            "description": "SUPER_ADMIN — Reactiva un tenant suspendido. Retorna 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/users?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "status", "value": "ACTIVE", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "description": "Lista usuarios del tenant con paginación y filtros opcionales: status (PENDING_ACTIVATION|ACTIVE|SUSPENDED|BLOCKED|DELETED) y search."
          }
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo.usuario@empresa.com\",\n  \"username\": \"nuevo.usuario\",\n  \"fullName\": \"Nuevo Usuario\",\n  \"phone\": \"3001234567\",\n  \"roleIds\": [],\n  \"sendInvite\": true\n}"
            },
            "description": "Crea un usuario dentro del tenant. sendInvite=true envía correo de activación."
          }
        },
        {
          "name": "Mi perfil (me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "Retorna el perfil del usuario autenticado (actor)."
          }
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{actor_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{actor_id}}"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "description": "Obtiene el detalle de un usuario específico del tenant."
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{actor_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{actor_id}}"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id",       "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",         "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin",  "value": "false" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nombre Actualizado\",\n  \"phone\": \"3009876543\",\n  \"photoUrl\": \"https://cdn.ejemplo.com/foto.png\"\n}"
            },
            "description": "Actualiza datos del usuario. X-Is-Tenant-Admin=true amplía los campos editables."
          }
        },
        {
          "name": "Suspender usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{actor_id}}/suspend",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{actor_id}}", "suspend"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "Suspende el usuario. Retorna 204 No Content."
          }
        },
        {
          "name": "Activar usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{actor_id}}/activate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{actor_id}}", "activate"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "Activa un usuario suspendido. Retorna 204 No Content."
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{actor_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{actor_id}}"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "Soft-delete del usuario. Retorna 204 No Content."
          }
        },
        {
          "name": "Asignar roles a usuario",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{actor_id}}/roles",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{actor_id}}", "roles"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignments\": [\n    {\n      \"roleId\": \"00000000-0000-0000-0000-000000000010\",\n      \"expiresAt\": null\n    }\n  ]\n}"
            },
            "description": "Reemplaza los roles del usuario. Los roles anteriores se eliminan y se asignan los nuevos."
          }
        }
      ]
    },
    {
      "name": "Invitaciones",
      "item": [
        {
          "name": "Invitar usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/invite",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "invite"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invitado@empresa.com\",\n  \"roleIds\": [\n    \"00000000-0000-0000-0000-000000000010\"\n  ]\n}"
            },
            "description": "Envía una invitación por email al usuario con los roles pre-asignados."
          }
        },
        {
          "name": "Aceptar invitación",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/invitations/accept",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "invitations", "accept"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"TOKEN_DE_INVITACION\",\n  \"username\": \"nuevo.usuario\",\n  \"fullName\": \"Nuevo Usuario Invitado\"\n}"
            },
            "description": "El usuario acepta la invitación usando el token recibido por email."
          }
        },
        {
          "name": "Listar invitaciones",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/users/invitations",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "invitations"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "description": "Lista todas las invitaciones del tenant (pendientes, aceptadas y revocadas)."
          }
        },
        {
          "name": "Revocar invitación",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/invitations/00000000-0000-0000-0000-000000000099/revoke",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "invitations", "00000000-0000-0000-0000-000000000099", "revoke"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "Revoca una invitación pendiente por su ID. Retorna 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Listar roles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/roles",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "description": "Lista todos los roles del tenant (incluye los de sistema: TENANT_ADMIN, EDITOR, VIEWER)."
          }
        },
        {
          "name": "Crear rol",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/roles",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SUPERVISOR\",\n  \"description\": \"Rol de supervisión con acceso de lectura extendido\",\n  \"isDefault\": false\n}"
            },
            "description": "Crea un rol personalizado para el tenant."
          }
        },
        {
          "name": "Obtener rol por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/roles/00000000-0000-0000-0000-000000000010",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles", "00000000-0000-0000-0000-000000000010"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "description": "Obtiene el detalle de un rol con el conteo de usuarios activos."
          }
        },
        {
          "name": "Actualizar rol",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/v1/roles/00000000-0000-0000-0000-000000000010",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles", "00000000-0000-0000-0000-000000000010"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SUPERVISOR\",\n  \"description\": \"Descripción actualizada del rol\",\n  \"isDefault\": false\n}"
            },
            "description": "Actualiza nombre y descripción del rol. No se pueden modificar roles de sistema."
          }
        },
        {
          "name": "Eliminar rol",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/roles/00000000-0000-0000-0000-000000000010",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles", "00000000-0000-0000-0000-000000000010"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "description": "Elimina un rol personalizado. Falla si el rol tiene usuarios asignados o es de sistema. Retorna 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Menu — Perfil de UI",
      "description": "Módulo menu: perfil completo de UI del usuario autenticado (user, permissions, menus).",
      "item": [
        {
          "name": "Perfil de UI — super.admin (tenant system)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/me/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me", "profile"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_system_id}}", "description": "Tenant system" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}",         "description": "super.admin" }
            ],
            "description": "Retorna el perfil de UI del usuario super.admin en el tenant system.\n\nEsperar:\n- user.roles: [\"SUPER_ADMIN\"]\n- permissions: todos los componentes con acceso efectivo\n- menus: árbol completo con location y access por ítem"
          }
        },
        {
          "name": "Perfil de UI — admin.demo (tenant demo)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/me/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me", "profile"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_demo_id}}", "description": "Tenant demo" },
              { "key": "X-Actor-Id",  "value": "{{actor_demo_id}}", "description": "admin.demo" }
            ],
            "description": "Retorna el perfil de UI del usuario admin.demo en el tenant demo.\n\nEsperar:\n- user.roles: [\"TENANT_ADMIN\"]\n- permissions: componentes con access execute/view/hidden\n- menus: navbar items con access execute, Administration con access hidden"
          }
        },
        {
          "name": "Perfil de UI — usuario no encontrado (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/me/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me", "profile"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_demo_id}}" },
              { "key": "X-Actor-Id",  "value": "00000000-0000-0000-0000-000000000099", "description": "UUID inexistente" }
            ],
            "description": "Debe retornar HTTP 404 con código NXC-MNU-0001."
          }
        },
        {
          "name": "Perfil de UI — header faltante (400)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/me/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me", "profile"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_demo_id}}" }
            ],
            "description": "Sin X-Actor-Id. Debe retornar HTTP 400 (header requerido faltante)."
          }
        }
      ]
    },
    {
      "name": "Componentes (Permisos)",
      "description": "Módulo permisos — Phase 1: consulta de componentes y sus elementos de UI. Los componentes se registran por seed/script; estos endpoints son de solo lectura.",
      "item": [
        {
          "name": "Listar componentes del tenant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/components?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "components"],
              "query": [
                { "key": "page",     "value": "0" },
                { "key": "size",     "value": "20" },
                { "key": "search",   "value": "", "disabled": true, "description": "Filtro sobre name y moduleKey" },
                { "key": "isSystem", "value": "true", "disabled": true, "description": "true = solo componentes de sistema" }
              ]
            },
            "header": [
              { "key": "X-Tenant-Id",      "value": "{{tenant_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "description": "UC-PRM-001 — Lista paginada de componentes del tenant, incluye componentes de sistema (is_system = TRUE). Soporta filtros: search (sobre name y moduleKey) e isSystem.\n\nRetorna: PageResponse<ComponentSummaryResponse> con elementCount por componente."
          }
        },
        {
          "name": "Obtener detalle de componente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/components/{{component_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "components", "{{component_id}}"]
            },
            "header": [
              { "key": "X-Tenant-Id",      "value": "{{tenant_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "description": "UC-PRM-002 — Retorna el detalle del componente con la lista completa de sus elementos de UI activos.\n\nError: 404 NXC-CMP-0001 si el componente no existe en el tenant."
          }
        },
        {
          "name": "Listar elementos de un componente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/components/{{component_id}}/elements",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "components", "{{component_id}}", "elements"]
            },
            "header": [
              { "key": "X-Tenant-Id",      "value": "{{tenant_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "description": "UC-PRM-002 — Lista los elementos de UI activos del componente (buttons, tabs, fields, sections, actions). Alimenta la tabla de elementos en la pantalla de permisos.\n\nError: 404 NXC-CMP-0001 si el componente no existe en el tenant."
          }
        }
      ]
    },
    {
      "name": "Permisos por Rol",
      "description": "Módulo permisos — Phase 1: gestión de permisos de UI por rol. Soporta asignación a nivel de componente y de elemento individual.",
      "item": [
        {
          "name": "Matriz de permisos del rol",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/permissions/roles/{{role_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "permissions", "roles", "{{role_id}}"]
            },
            "header": [
              { "key": "X-Tenant-Id",      "value": "{{tenant_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "description": "UC-PRM-003 — API principal de la pantalla de gestión de permisos. Retorna todos los componentes del tenant con el nivel de acceso configurado para el rol, y dentro de cada componente todos sus elementos con el campo `inherited` indicando si el acceso viene del componente padre o de una regla explícita de elemento.\n\nEjemplo de response:\n{\n  \"roleId\": \"...\",\n  \"roleName\": \"EDITOR\",\n  \"tenantId\": \"...\",\n  \"components\": [\n    {\n      \"componentId\": \"...\",\n      \"moduleKey\": \"user-management\",\n      \"name\": \"Gestión de usuarios\",\n      \"route\": \"/admin/users\",\n      \"access\": \"execute\",\n      \"elements\": [\n        { \"elementId\": \"...\", \"elementKey\": \"btn-delete-user\", \"access\": \"view\", \"inherited\": false },\n        { \"elementId\": \"...\", \"elementKey\": \"searchInput\",     \"access\": \"execute\", \"inherited\": true }\n      ]\n    }\n  ]\n}\n\nError: 404 NXC-PRM-0001 si el rol no pertenece al tenant."
          }
        },
        {
          "name": "Asignar permiso a un componente (upsert)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/permissions/roles/{{role_id}}/components/{{component_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "permissions", "roles", "{{role_id}}", "components", "{{component_id}}"]
            },
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Tenant-Id",       "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",         "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin",  "value": "true" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access\": \"EXECUTE\"\n}"
            },
            "description": "UC-PRM-004 — Asigna o actualiza (upsert) el nivel de acceso de un rol sobre un componente completo. Si no existía el registro lo crea; si ya existía lo actualiza. Usa INSERT ON CONFLICT DO UPDATE.\n\nValores válidos para access: HIDDEN | VIEW | EXECUTE\n\nRetorna: ComponentPermissionResultResponse\n\nErrores:\n- 404 NXC-PRM-0001: rol no encontrado en el tenant\n- 404 NXC-CMP-0001: componente no encontrado en el tenant"
          }
        },
        {
          "name": "Asignar permisos a múltiples componentes (batch upsert)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/permissions/roles/{{role_id}}/components/batch",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "permissions", "roles", "{{role_id}}", "components", "batch"]
            },
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Tenant-Id",       "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",         "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin",  "value": "true" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\n    { \"componentId\": \"{{component_id}}\", \"access\": \"EXECUTE\" }\n  ]\n}"
            },
            "description": "UC-PRM-005 — Asigna o actualiza (upsert) en una sola transacción los permisos de un rol sobre múltiples componentes. Útil para la acción 'aplicar a todos' en el UI. Máximo 100 componentes por request.\n\nSi algún componentId no pertenece al tenant, la operación entera falla antes de ejecutar ningún upsert.\n\nRetorna: List<ComponentPermissionResultResponse>\n\nErrores:\n- 404 NXC-PRM-0001: rol no encontrado\n- 422 NXC-PRM-0002: uno o más componentIds no pertenecen al tenant (incluye la lista de IDs inválidos)"
          }
        },
        {
          "name": "Asignar permiso a un elemento (upsert)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/permissions/roles/{{role_id}}/elements/{{element_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "permissions", "roles", "{{role_id}}", "elements", "{{element_id}}"]
            },
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Tenant-Id",       "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",         "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin",  "value": "true" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access\": \"VIEW\"\n}"
            },
            "description": "UC-PRM-006 — Asigna o actualiza (upsert) el nivel de acceso de un rol sobre un elemento de UI específico. Sobrescribe la herencia del componente padre con un permiso granular. El campo `inherited` en la respuesta será siempre false tras este upsert.\n\nValores válidos para access: HIDDEN | VIEW | EXECUTE\n\nRetorna: ElementPermissionResultResponse\n\nErrores:\n- 404 NXC-PRM-0001: rol no encontrado en el tenant\n- 404 NXC-ELM-0001: elemento no encontrado"
          }
        }
      ]
    },
    {
      "name": "Autenticación (Auth Service)",
      "description": "Endpoints del servicio de autenticación: login 2FA, gestión de sesiones y recuperación de contraseña.",
      "item": [
        {
          "name": "Login - Paso 1 (Enviar OTP)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/login",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "login"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenant_id}}\",\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "description": "Paso 1 del login 2FA: valida credenciales y envía OTP al email del usuario.\n\nRespuesta exitosa (200):\n{\n  \"challengeToken\": \"eyJhbGc...\",\n  \"message\": \"OTP sent to your email\",\n  \"expiresIn\": 300\n}\n\nGuardar challengeToken en variable de entorno para el paso 2."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('challenge_token', jsonData.challengeToken);",
                  "    console.log('Challenge token saved:', jsonData.challengeToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Paso 2 (Verificar OTP)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/verify-otp",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "verify-otp"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeToken\": \"{{challenge_token}}\",\n  \"code\": \"123456\"\n}"
            },
            "description": "Paso 2 del login 2FA: verifica el código OTP recibido por email.\n\nRespuesta exitosa (200):\n{\n  \"token\": \"eyJhbGc...\",\n  \"refreshToken\": \"a1b2c3...\",\n  \"expiresIn\": 900,\n  \"profile\": { ... }\n}\n\nGuardar token, refreshToken y sessionId para uso posterior."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.token);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "    console.log('Access token saved');",
                  "    console.log('Refresh token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refrescar Token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/refresh",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "refresh"]
            },
            "header": [
              { "key": "X-Refresh-Token", "value": "{{refresh_token}}" }
            ],
            "description": "Genera un nuevo access token usando el refresh token.\n\nRespuesta exitosa (200):\n{\n  \"token\": \"eyJhbGc...\",\n  \"refreshToken\": \"a1b2c3...\",\n  \"expiresIn\": 900,\n  \"profile\": { ... }\n}\n\nEl refreshToken se mantiene igual."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.token);",
                  "    console.log('Access token refreshed');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout - Cerrar Sesión",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{auth_base_url}}/auth/logout?sessionId={{session_id}}",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "logout"],
              "query": [
                { "key": "sessionId", "value": "{{session_id}}" }
              ]
            },
            "description": "Cierra la sesión actual invalidando el refresh token.\n\nRespuesta exitosa (200):\n{\n  \"message\": \"Logged out successfully\"\n}"
          }
        },
        {
          "name": "Logout All - Cerrar Todas las Sesiones",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{auth_base_url}}/auth/logout-all?userId={{user_id}}&currentSessionId={{session_id}}",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "logout-all"],
              "query": [
                { "key": "userId", "value": "{{user_id}}" },
                { "key": "currentSessionId", "value": "{{session_id}}" }
              ]
            },
            "description": "Cierra todas las sesiones del usuario excepto la actual.\n\nRespuesta exitosa (200):\n{\n  \"message\": \"All other sessions have been logged out\"\n}"
          }
        },
        {
          "name": "Solicitar Reset de Contraseña",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/password/reset/request",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "password", "reset", "request"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenant_id}}\",\n  \"email\": \"usuario@empresa.com\"\n}"
            },
            "description": "Solicita un reset de contraseña enviando un email con el token.\n\nRespuesta exitosa (200):\n{\n  \"message\": \"Password reset email sent\"\n}\n\nEl token se envía por email y tiene validez de 1 hora."
          }
        },
        {
          "name": "Confirmar Reset de Contraseña",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/password/reset/confirm",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "password", "reset", "confirm"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"RESET_TOKEN_FROM_EMAIL\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "description": "Confirma el reset usando el token recibido por email y establece la nueva contraseña.\n\nRespuesta exitosa (200):\n{\n  \"message\": \"Password reset successfully\"\n}"
          }
        },
        {
          "name": "Cambiar Contraseña (Usuario Autenticado)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{auth_base_url}}/auth/password?userId={{user_id}}",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "password"],
              "query": [
                { "key": "userId", "value": "{{user_id}}" }
              ]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"OldPassword123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "description": "Permite al usuario autenticado cambiar su contraseña proporcionando la contraseña actual.\n\nRespuesta exitosa (200):\n{\n  \"message\": \"Password changed successfully\"\n}"
          }
        }
      ]
    }
  ]
}
