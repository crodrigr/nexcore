{
  "info": {
    "name": "Nexcore - Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de endpoints NexCore: módulo tenant (Tenants, Usuarios, Roles) y módulo menu (Perfil de UI). Todos los endpoints bajo /api/** requieren X-Actor-Id y X-Tenant-Id (validados por RoleApiPolicyInterceptor con Redis)."
  },
  "variable": [
    { "key": "base_url",          "value": "http://localhost:8080" },
    { "key": "auth_base_url",     "value": "http://localhost:8081", "description": "Base URL for Auth Service" },
    { "key": "tenant_system_id",  "value": "00000000-0000-0000-0000-000000000001", "description": "Tenant system" },
    { "key": "tenant_demo_id",    "value": "00000000-0000-0000-0000-000000000002", "description": "Tenant demo" },
    { "key": "tenant_id",         "value": "00000000-0000-0000-0000-000000000001", "description": "Tenant activo (system=SUPER_ADMIN, demo=TENANT_ADMIN/EDITOR)" },
    { "key": "actor_id",          "value": "00000000-0000-0000-0001-000000000001", "description": "super.admin — usuario autenticado que hace la petición (X-Actor-Id)" },
    { "key": "actor_demo_id",     "value": "00000000-0000-0000-0001-000000000002", "description": "admin.demo (tenant demo, rol TENANT_ADMIN) — usuario autenticado alternativo" },
    { "key": "actor_editor_id",   "value": "00000000-0000-0000-0001-000000000005", "description": "test.editor (tenant demo, rol EDITOR) — usuario autenticado alternativo" },
    { "key": "target_user_id",    "value": "00000000-0000-0000-0001-000000000002", "description": "admin.demo — usuario objetivo en la URL (el que se consulta/actualiza/suspende/elimina)" },
    { "key": "tenant_slug",       "value": "demo" },
    { "key": "test_username",     "value": "super.admin" },
    { "key": "test_password",     "value": "NexCore@2026!" },
    { "key": "challenge_token",   "value": "", "description": "Token from login (step 1)" },
    { "key": "access_token",      "value": "", "description": "JWT access token" },
    { "key": "refresh_token",     "value": "", "description": "Refresh token" },
    { "key": "session_id",        "value": "", "description": "Current session ID" },
    { "key": "user_id",           "value": "", "description": "Current user ID" },
    { "key": "component_id",      "value": "", "description": "UUID del componente (completar con UUID real de la BD)" },
    { "key": "role_id",           "value": "00000000-0000-0000-0000-000000000010", "description": "UUID del rol TENANT_ADMIN del tenant demo" },
    { "key": "element_id",        "value": "", "description": "UUID del elemento de componente (completar con UUID real de la BD)" }
  ],
  "item": [
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Listar tenants",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN — Lista todos los tenants paginados.\ntenant_id=system, actor_id=super.admin"
          }
        },
        {
          "name": "Crear tenant",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"mi-empresa\",\n  \"name\": \"Mi Empresa SAS\",\n  \"legalName\": \"Mi Empresa S.A.S.\",\n  \"taxId\": \"900123456-1\",\n  \"plan\": \"STARTER\",\n  \"mode\": \"SAAS_SHARED\",\n  \"timezone\": \"America/Bogota\",\n  \"locale\": \"es-CO\",\n  \"dateFormat\": \"DD/MM/YYYY\",\n  \"currency\": \"COP\"\n}"
            },
            "description": "SUPER_ADMIN — Crea un nuevo tenant. El trigger de BD crea automáticamente los roles TENANT_ADMIN, EDITOR y VIEWER."
          }
        },
        {
          "name": "Obtener tenant por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Obtiene el detalle de un tenant por su UUID."
          }
        },
        {
          "name": "Actualizar tenant",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}"]
            },
            "header": [
              { "key": "Content-Type",       "value": "application/json" },
              { "key": "X-Tenant-Id",        "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",         "value": "{{actor_id}}" },
              { "key": "X-Actor-Super-Admin", "value": "false" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mi Empresa Actualizada SAS\",\n  \"legalName\": \"Mi Empresa Actualizada S.A.S.\",\n  \"timezone\": \"America/Bogota\",\n  \"locale\": \"es-CO\",\n  \"mfaRequired\": false,\n  \"sessionTimeoutMinutes\": 480,\n  \"maxLoginAttempts\": 5,\n  \"passwordMinLength\": 8,\n  \"passwordRequiresUpper\": true,\n  \"passwordRequiresSpecial\": false\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN — Actualiza datos del tenant. X-Actor-Super-Admin=true permite cambiar plan/modo."
          }
        },
        {
          "name": "Suspender tenant",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/suspend",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "suspend"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN — Suspende el tenant. Retorna 204 No Content."
          }
        },
        {
          "name": "Activar tenant",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/activate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "activate"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN — Reactiva un tenant suspendido. Retorna 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/users?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "page",   "value": "0" },
                { "key": "size",   "value": "20" },
                { "key": "status", "value": "ACTIVE", "disabled": true },
                { "key": "search", "value": "",        "disabled": true }
              ]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Lista usuarios del tenant.\nPara tenant demo usar: tenant_id={{tenant_demo_id}}, actor_id={{actor_demo_id}}"
          }
        },
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo.usuario@empresa.com\",\n  \"username\": \"nuevo.usuario\",\n  \"fullName\": \"Nuevo Usuario\",\n  \"phone\": \"3001234567\",\n  \"roleIds\": [],\n  \"sendInvite\": true\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN — Crea un usuario dentro del tenant. sendInvite=true envía correo de activación."
          }
        },
        {
          "name": "Mi perfil (me)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "* (cualquier rol autenticado) — Retorna el perfil del usuario autenticado."
          }
        },
        {
          "name": "Obtener usuario por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{target_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{target_user_id}}"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN / EDITOR — Obtiene el detalle de un usuario específico del tenant."
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{target_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{target_user_id}}"]
            },
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Tenant-Id",       "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",        "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "false" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nombre Actualizado\",\n  \"phone\": \"3009876543\",\n  \"photoUrl\": \"https://cdn.ejemplo.com/foto.png\"\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN / EDITOR — Actualiza datos del usuario. EDITOR solo puede editar su propio perfil (validado en capa de negocio)."
          }
        },
        {
          "name": "Suspender usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{target_user_id}}/suspend",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{target_user_id}}", "suspend"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Suspende el usuario. EDITOR recibe 403. Retorna 204 No Content."
          }
        },
        {
          "name": "Activar usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{target_user_id}}/activate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{target_user_id}}", "activate"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Activa un usuario suspendido. EDITOR recibe 403. Retorna 204 No Content."
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{target_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{target_user_id}}"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Soft-delete del usuario. EDITOR recibe 403. Retorna 204 No Content."
          }
        },
        {
          "name": "Asignar roles a usuario",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{target_user_id}}/roles",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{target_user_id}}", "roles"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignments\": [\n    {\n      \"roleId\": \"00000000-0000-0000-0000-000000000010\",\n      \"expiresAt\": null\n    }\n  ]\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN — Reemplaza los roles del usuario."
          }
        }
      ]
    },
    {
      "name": "Invitaciones",
      "item": [
        {
          "name": "Invitar usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/invite",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "invite"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invitado@empresa.com\",\n  \"roleIds\": [\n    \"00000000-0000-0000-0000-000000000010\"\n  ]\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN — Envía una invitación por email."
          }
        },
        {
          "name": "Aceptar invitación",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/invitations/accept",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "invitations", "accept"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"TOKEN_DE_INVITACION\",\n  \"username\": \"nuevo.usuario\",\n  \"fullName\": \"Nuevo Usuario Invitado\"\n}"
            },
            "description": "PÚBLICO — Endpoint excluido del interceptor. No requiere X-Actor-Id."
          }
        },
        {
          "name": "Listar invitaciones",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/users/invitations",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "invitations"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Lista todas las invitaciones del tenant."
          }
        },
        {
          "name": "Revocar invitación",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/users/invitations/00000000-0000-0000-0000-000000000099/revoke",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "invitations", "00000000-0000-0000-0000-000000000099", "revoke"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Revoca una invitación pendiente. Retorna 204 No Content."
          }
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Listar roles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/roles",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN / EDITOR / VIEWER — Lista todos los roles del tenant."
          }
        },
        {
          "name": "Crear rol",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/roles",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SUPERVISOR\",\n  \"description\": \"Rol de supervisión con acceso de lectura extendido\",\n  \"isDefault\": false\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN — Crea un rol personalizado para el tenant."
          }
        },
        {
          "name": "Obtener rol por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/roles/00000000-0000-0000-0000-000000000010",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles", "00000000-0000-0000-0000-000000000010"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN / EDITOR / VIEWER — Obtiene el detalle de un rol."
          }
        },
        {
          "name": "Actualizar rol",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/v1/roles/00000000-0000-0000-0000-000000000010",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles", "00000000-0000-0000-0000-000000000010"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SUPERVISOR\",\n  \"description\": \"Descripción actualizada del rol\",\n  \"isDefault\": false\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN — Actualiza nombre y descripción del rol."
          }
        },
        {
          "name": "Eliminar rol",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/roles/00000000-0000-0000-0000-000000000010",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "roles", "00000000-0000-0000-0000-000000000010"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Elimina un rol personalizado. Falla si tiene usuarios asignados o es de sistema. Retorna 204."
          }
        }
      ]
    },
    {
      "name": "Menu — Perfil de UI",
      "description": "Módulo menu: perfil completo de UI del usuario autenticado.",
      "item": [
        {
          "name": "Perfil de UI — super.admin (tenant system)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/me/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me", "profile"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_system_id}}", "description": "Tenant system" },
              { "key": "X-Actor-Id",  "value": "{{actor_id}}",         "description": "super.admin" }
            ],
            "description": "* — Retorna el perfil de UI del usuario super.admin en el tenant system.\n\nEsperar:\n- user.roles: [\"SUPER_ADMIN\"]\n- permissions: todos los componentes\n- menus: árbol completo"
          }
        },
        {
          "name": "Perfil de UI — admin.demo (tenant demo)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/me/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me", "profile"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_demo_id}}", "description": "Tenant demo" },
              { "key": "X-Actor-Id",  "value": "{{actor_demo_id}}", "description": "admin.demo" }
            ],
            "description": "* — Retorna el perfil de UI del usuario admin.demo en el tenant demo."
          }
        },
        {
          "name": "Perfil de UI — usuario no encontrado (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/me/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me", "profile"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_demo_id}}" },
              { "key": "X-Actor-Id",  "value": "00000000-0000-0000-0000-000000000099", "description": "UUID inexistente" }
            ],
            "description": "Debe retornar HTTP 404 con código NXC-MNU-0001. El interceptor deja pasar (UUID válido) pero el servicio responde 404."
          }
        },
        {
          "name": "Perfil de UI — sin X-Actor-Id (401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/me/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me", "profile"]
            },
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenant_demo_id}}" }
            ],
            "description": "Sin X-Actor-Id. El interceptor retorna HTTP 401 Authentication required."
          }
        }
      ]
    },
    {
      "name": "Componentes (Permisos)",
      "description": "Módulo permisos — consulta de componentes y sus elementos de UI.",
      "item": [
        {
          "name": "Listar componentes del tenant",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/components?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "components"],
              "query": [
                { "key": "page",     "value": "0" },
                { "key": "size",     "value": "20" },
                { "key": "search",   "value": "", "disabled": true },
                { "key": "isSystem", "value": "true", "disabled": true }
              ]
            },
            "header": [
              { "key": "X-Tenant-Id",      "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",        "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Lista paginada de componentes del tenant."
          }
        },
        {
          "name": "Obtener detalle de componente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/components/{{component_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "components", "{{component_id}}"]
            },
            "header": [
              { "key": "X-Tenant-Id",      "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",        "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Retorna el detalle del componente con sus elementos."
          }
        },
        {
          "name": "Listar elementos de un componente",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/components/{{component_id}}/elements",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "components", "{{component_id}}", "elements"]
            },
            "header": [
              { "key": "X-Tenant-Id",      "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",        "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Lista los elementos de UI activos del componente."
          }
        }
      ]
    },
    {
      "name": "Permisos por Rol",
      "description": "Módulo permisos — gestión de permisos de UI por rol.",
      "item": [
        {
          "name": "Matriz de permisos del rol",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/permissions/roles/{{role_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "permissions", "roles", "{{role_id}}"]
            },
            "header": [
              { "key": "X-Tenant-Id",      "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",        "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "description": "SUPER_ADMIN / TENANT_ADMIN — Retorna todos los componentes con el nivel de acceso configurado para el rol."
          }
        },
        {
          "name": "Asignar permiso a un componente (upsert)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/permissions/roles/{{role_id}}/components/{{component_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "permissions", "roles", "{{role_id}}", "components", "{{component_id}}"]
            },
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Tenant-Id",       "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",        "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access\": \"EXECUTE\"\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN — Asigna o actualiza (upsert) el nivel de acceso de un rol sobre un componente."
          }
        },
        {
          "name": "Asignar permisos a múltiples componentes (batch upsert)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/permissions/roles/{{role_id}}/components/batch",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "permissions", "roles", "{{role_id}}", "components", "batch"]
            },
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Tenant-Id",       "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",        "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\n    { \"componentId\": \"{{component_id}}\", \"access\": \"EXECUTE\" }\n  ]\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN — Upsert en una transacción para múltiples componentes. Máximo 100."
          }
        },
        {
          "name": "Asignar permiso a un elemento (upsert)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/v1/menu/permissions/roles/{{role_id}}/elements/{{element_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "menu", "permissions", "roles", "{{role_id}}", "elements", "{{element_id}}"]
            },
            "header": [
              { "key": "Content-Type",      "value": "application/json" },
              { "key": "X-Tenant-Id",       "value": "{{tenant_id}}" },
              { "key": "X-Actor-Id",        "value": "{{actor_id}}" },
              { "key": "X-Is-Tenant-Admin", "value": "true" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access\": \"VIEW\"\n}"
            },
            "description": "SUPER_ADMIN / TENANT_ADMIN — Asigna permiso granular a un elemento de UI específico."
          }
        }
      ]
    },
    {
      "name": "Autenticación (Auth Service)",
      "description": "Endpoints del servicio de autenticación (puerto 8081). Los endpoints públicos no requieren headers de auth.",
      "item": [
        {
          "name": "Login - Paso 1 (Enviar OTP)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/login",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "login"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenant_id}}\",\n  \"username\": \"{{test_username}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "description": "PÚBLICO — Valida credenciales y envía OTP al email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('challenge_token', jsonData.challengeToken);",
                  "    console.log('Challenge token saved:', jsonData.challengeToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Paso 2 (Verificar OTP)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/verify-otp",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "verify-otp"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeToken\": \"{{challenge_token}}\",\n  \"code\": \"111111\"\n}"
            },
            "description": "PÚBLICO — Verifica el OTP. OTP fijo de desarrollo: 111111 (usuarios: super.admin, test.admin, test.editor en tenant demo)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.token);",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refreshToken);",
                  "    console.log('Access token saved');",
                  "    console.log('Refresh token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refrescar Token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/refresh",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "refresh"]
            },
            "header": [
              { "key": "X-Refresh-Token", "value": "{{refresh_token}}" }
            ],
            "description": "Autenticado — Genera un nuevo access token usando el refresh token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.token);",
                  "    console.log('Access token refreshed');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout - Cerrar Sesión",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{auth_base_url}}/auth/logout?sessionId={{session_id}}",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "logout"],
              "query": [
                { "key": "sessionId", "value": "{{session_id}}" }
              ]
            },
            "description": "Autenticado — Cierra la sesión actual invalidando el refresh token."
          }
        },
        {
          "name": "Logout All - Cerrar Todas las Sesiones",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{auth_base_url}}/auth/logout-all?userId={{user_id}}&currentSessionId={{session_id}}",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "logout-all"],
              "query": [
                { "key": "userId",           "value": "{{user_id}}" },
                { "key": "currentSessionId", "value": "{{session_id}}" }
              ]
            },
            "description": "Autenticado — Cierra todas las sesiones excepto la actual."
          }
        },
        {
          "name": "Solicitar Reset de Contraseña",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/password/reset/request",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "password", "reset", "request"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"{{tenant_id}}\",\n  \"email\": \"usuario@empresa.com\"\n}"
            },
            "description": "PÚBLICO — Solicita un reset de contraseña enviando email con token."
          }
        },
        {
          "name": "Confirmar Reset de Contraseña",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{auth_base_url}}/auth/password/reset/confirm",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "password", "reset", "confirm"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"RESET_TOKEN_FROM_EMAIL\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "description": "PÚBLICO — Confirma el reset con el token del email."
          }
        },
        {
          "name": "Cambiar Contraseña (Usuario Autenticado)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{auth_base_url}}/auth/password?userId={{user_id}}",
              "host": ["{{auth_base_url}}"],
              "path": ["auth", "password"],
              "query": [
                { "key": "userId", "value": "{{user_id}}" }
              ]
            },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"OldPassword123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "description": "Autenticado — Permite al usuario cambiar su contraseña."
          }
        }
      ]
    }
  ]
}
